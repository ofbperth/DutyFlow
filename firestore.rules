rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'ofbperth@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isScheduler() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'ofbperth@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'scheduler' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasSchedulerScope() {
      return isScheduler() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAll(['homeGroupId']);
    }

    function isOwnGroupShift(shift) {
      return hasSchedulerScope() &&
        shift.targetGroupId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.homeGroupId &&
        get(/databases/$(database)/documents/users/$(shift.userId)).data.keys().hasAll(['homeGroupId']) &&
        get(/databases/$(database)/documents/users/$(shift.userId)).data.homeGroupId ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.homeGroupId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isScheduler() && request.resource.data.role == 'user') ||
        (isOwner(userId) && request.resource.data.role == 'user')
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
          (request.resource.data.role == 'user' || request.resource.data.role == 'scheduler'))
      );
      allow delete: if isAdmin();
    }

    // 3. Shift Templates collection
    match /shiftTemplates/{templateId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Shifts collection
    match /shifts/{shiftId=**} {
      allow read: if true;
      allow create, update: if isAdmin() || isOwnGroupShift(request.resource.data);
      allow delete: if isAdmin() || isOwnGroupShift(resource.data);
    }

    // 5. Availabilities collection
    match /availabilities/{availabilityId=**} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (request.resource.data.userId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (resource.data.userId == request.auth.uid)
      );
    }

    // 6. Shift Swaps collection
    match /shiftSwaps/{swapId=**} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (request.resource.data.requestingUserId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (resource.data.requestingUserId == request.auth.uid) ||
        (resource.data.targetUserId == request.auth.uid)
      );
      allow delete: if isAdmin() || isScheduler();
    }

    // 7. Holidays collection
    match /holidays/{holidayId=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Config collection
    match /config/{configId=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. Test connection
    match /test/{docId=**} {
      allow read, write: if true;
    }

    // 10. Doctor Groups collection
    match /doctorGroups/{groupId=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Rotation Assignments collection
    match /rotationAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
