rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'ofbperth@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isScheduler() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'ofbperth@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'scheduler' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || isScheduler() || isOwner(userId));
      allow update: if isAuthenticated() && (isAdmin() || isOwner(userId) || (isScheduler() && resource.data.isVirtual == true));
      allow delete: if isAdmin();
    }

    // 2. Departments collection
    match /departments/{departmentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Shift Templates collection
    match /shiftTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isScheduler();
    }

    // 4. Shifts collection
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isScheduler();
    }

    // 5. Availabilities collection
    match /availabilities/{availabilityId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (request.resource.data.userId == request.auth.uid)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (resource.data.userId == request.auth.uid)
      );
    }

    // 6. Shift Swaps collection
    match /shiftSwaps/{swapId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (request.resource.data.requestingUserId == request.auth.uid)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isScheduler() ||
        (resource.data.requestingUserId == request.auth.uid) ||
        (resource.data.targetUserId == request.auth.uid)
      );
      allow delete: if isAdmin() || isScheduler();
    }

    // 7. Holidays collection
    match /holidays/{holidayId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 8. Config collection
    match /config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isScheduler();
    }

    // 9. Test connection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
